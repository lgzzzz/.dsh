{
  "name": "dsh-kbd-nav-focus",
  "version": "1.0.0",
  "private": true,
  "description": "本地持久化插件（浏览器半部）：Alt+Shift 进入自由移动焦点，方向键移动、任意字母键左键点击且焦点停留原地，任何非字母非方向键退出并回输入框；起点为侧边栏当前会话。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
